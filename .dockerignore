# dash docs-site .dockerignore — trims the REPO-ROOT build context.
#
# The docs site (docs/) documents the gem via `gem "dash", path: ".."`, so the
# Docker build context is the repo root: the gem at /app, the app at /app/docs
# (see docs/Dockerfile). This file keeps that context small — without it the
# daemon ships test artifacts, node_modules, and editor state into the build and
# the COPY layers balloon.
#
# .git can be dropped: dash.gemspec packages its files with Dir[] (no
# `git ls-files`), so the path dep resolves from a plain checkout.
/.git/
/.gitignore
/.gitattributes

# Editor + AI-assistant configs.
/.claude/
/.cursor/
/.vscode/
/.idea/
/.ruby-lsp/
/.worktrees/

# Gem-level dev/test artifacts — not part of the docs app image. The gemspec's
# file list is lib/ + MIT-LICENSE + README.md; it never ships test/, so
# excluding it can't starve `bundle install`.
/test/
/tmp/
/pkg/
/doc/

# CI meta.
/.github/

# Bundler config (the Dockerfile's BUNDLE_* env drives the install).
/.bundle
/docs/.bundle

# Environment files and credentials — never bake secrets into an image.
/.env*
/docs/.env*
/docs/config/master.key
/docs/config/credentials/*.key

# --- The docs app (docs/) --------------------------------------------------
# JS deps + generated assets: `bun install` + `assets:precompile` rebuild these
# inside the build stage.
/docs/node_modules/
/docs/app/assets/builds/*
!/docs/app/assets/builds/.keep
# Generated by bin/build-css — Tailwind resolves the gem @source globs at build.
/docs/app/assets/stylesheets/tailwind.sources.css
/docs/public/assets

# Logs and tempfiles (keep the dirs, drop the contents).
/docs/log/*
!/docs/log/.keep
/docs/tmp/*
!/docs/tmp/.keep
/docs/tmp/pids/*
!/docs/tmp/pids/.keep

# The docs app's own tests + deploy meta.
/docs/spec/
/docs/.rspec
/docs/coverage/
/docs/.kamal/
