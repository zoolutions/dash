#!/usr/bin/env ruby
# Regenerate test/fixtures/kamal_proxy_flags.yml — the flag manifest that
# test/proxy_flag_coverage_test.rb checks the gem's deploy.yml surface against.
#
# Run this whenever Dash::Configuration::Proxy::Run::MINIMUM_VERSION moves. The
# coverage test refuses to pass while the manifest names a different version, so
# forgetting is loud rather than silent.
#
#   bin/sync-proxy-flags                        # pull the image at MINIMUM_VERSION
#   bin/sync-proxy-flags --binary ./dash-proxy # use a locally built binary
#
# The flag list comes from Cobra's own `--help` output, not from a regex over the
# Go source. That is deliberate: the source has flags registered via Int64Var,
# Uint16Var and friends, and a "good enough" regex silently misses them. Cobra
# prints what Cobra will accept.

require "yaml"
require "open3"

# Read the constant textually rather than requiring the file — proxy/run.rb pulls
# in the whole Zeitwerk/ActiveSupport stack, which this script has no use for.
RUN_CONFIG = File.expand_path("../lib/dash/configuration/proxy/run.rb", __dir__)
MINIMUM_VERSION = File.read(RUN_CONFIG)[/MINIMUM_VERSION\s*=\s*"([^"]+)"/, 1] or
  abort "could not read MINIMUM_VERSION from #{RUN_CONFIG}"

# The two subcommands that carry configuration. Other subcommands (list, stop,
# pause, drain, ...) take no operator-tunable options, so they are out of scope
# for deploy.yml coverage.
SUBCOMMANDS = %w[ deploy run ].freeze

# Cobra adds --help to every command. It is not a configuration surface.
BUILTIN_FLAGS = %w[ help ].freeze

def run!(*command)
  stdout, stderr, status = Open3.capture3(*command)
  abort "#{command.join(" ")} failed:\n#{stderr}" unless status.success?
  stdout
end

def flags_for(invocation, subcommand)
  help = run!(*invocation, subcommand, "--help")

  help.scan(/^\s+(?:-\w, )?--([a-z0-9-]+)/).flatten.uniq.sort - BUILTIN_FLAGS
end

# The DNS providers dash-proxy will accept for --acme-dns-provider, read off the
# parenthesised list in the flag's own usage text. The gem validates
# proxy/run/acme/dns_provider against this, and rejecting a provider the proxy
# supports blocks a deploy - so the list has to move with the image, not with
# whoever last remembered to edit a constant.
#
# Whitespace is squashed first because Cobra wraps long usage strings.
def dns_providers_for(invocation)
  help = run!(*invocation, "run", "--help").gsub(/\s+/, " ")
  advertised = help[/--acme-dns-provider\b[^(]*\(([^)]*)\)/, 1] or
    abort "could not find the provider list in --acme-dns-provider's usage text"

  # v1.0.0.5 prefixes the list with a label ("one of: cloudflare, ..."); strip
  # it so only names survive. Older images without the label pass through.
  advertised.sub(/\A[^:]*:\s*/, "").split(",").map(&:strip).sort
end

version = MINIMUM_VERSION

invocation =
  if (index = ARGV.index("--binary"))
    [ ARGV.fetch(index + 1) { abort "--binary needs a path" } ]
  else
    image = "ghcr.io/zoolutions/dash-proxy:#{version}"
    warn "Pulling #{image}..."
    run!("docker", "pull", "--quiet", image)
    [ "docker", "run", "--rm", image, "dash-proxy" ]
  end

manifest = {
  "proxy_version" => version,
  "generated_by" => "bin/sync-proxy-flags",
  "acme_dns_providers" => dns_providers_for(invocation),
  "flags" => SUBCOMMANDS.to_h { |subcommand| [ subcommand, flags_for(invocation, subcommand) ] }
}

path = File.expand_path("../test/fixtures/kamal_proxy_flags.yml", __dir__)
File.write path, <<~HEADER + manifest.to_yaml.sub(/\A---\n/, "")
  ---
  # Generated by bin/sync-proxy-flags — do not edit by hand.
  # Refresh whenever MINIMUM_VERSION moves; test/proxy_flag_coverage_test.rb
  # fails while proxy_version here disagrees with MINIMUM_VERSION.
HEADER

SUBCOMMANDS.each { |sub| puts "#{sub}: #{manifest["flags"][sub].size} flags" }
puts "acme dns providers: #{manifest["acme_dns_providers"].size}"
puts "wrote #{path} for #{version}"
